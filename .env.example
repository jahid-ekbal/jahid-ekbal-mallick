# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema files in "/src/lib/env"
# directory should be updated accordingly.

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Disable Prisma telemetry
CHECKPOINT_DISABLE=1

# Example connection string for SQLite (local dev):
DATABASE_URL=file:./prisma/dev.db

# ---------------------------------------------------------------------------
# Production (Vercel + Turso)
# Local SQLite files do not persist on serverless, so production uses Turso.
#   1. turso db create portfolio
#   2. turso db show portfolio --url          -> DATABASE_URL  (libsql://...)
#   3. turso db tokens create portfolio       -> TURSO_AUTH_TOKEN
#   4. bun run db:deploy                      (push migrations to Turso,
#      DATABASE_URL/TURSO_AUTH_TOKEN pointed at Turso in your shell or .env)
#   5. bun run db:seed                        (same env override, seeds profile)
# In Vercel set DATABASE_URL + TURSO_AUTH_TOKEN (+ vars below) and optionally
# NEXT_PUBLIC_SITE_URL = https://<your-domain> for canonical/OG/sitemap URLs.
# ---------------------------------------------------------------------------
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Discord bot (portfolio control plane)
# Create an application at https://discord.com/developers/applications
# Bot -> Token -> Copy                       = DISCORD_BOT_TOKEN
# General Information -> Application ID      = DISCORD_APPLICATION_ID
# General Information -> Public Key          = DISCORD_PUBLIC_KEY
# Your Discord user ID (Developer Mode ->
#   right-click yourself -> Copy User ID)    = DISCORD_OWNER_USER_ID
# Private log channel ID (optional mirror of
#   contact form submissions)                = DISCORD_LOG_CHANNEL_ID
# All five below are optional: the site builds and runs without them, but the
# bot endpoint and contact-form DM delivery stay disabled until they are set.
#
# Delivery modes are mutually exclusive (Discord delivers interactions over
# gateway OR webhook): leave "Interactions Endpoint URL" EMPTY in the Dev
# Portal while developing locally (the `bun dev` gateway sidecar receives
# commands); after deploying to Vercel, set it to
#   https://<domain>/api/discord/interactions
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_OWNER_USER_ID=
DISCORD_LOG_CHANNEL_ID=
