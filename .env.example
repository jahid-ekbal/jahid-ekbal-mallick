# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema files in "/src/lib/env"
# directory should be updated accordingly.

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Disable Prisma telemetry
CHECKPOINT_DISABLE=1

# Example connection string for SQLite (local dev):
DATABASE_URL=file:./prisma/dev.db

# ---------------------------------------------------------------------------
# Production (Render + Turso)
# Local SQLite files do not persist across instances, so production uses
# Turso through the same libSQL adapter (see render.yaml Blueprint).
#   1. turso db create portfolio
#   2. turso db show portfolio --url          -> DATABASE_URL  (libsql://...)
#   3. turso db tokens create portfolio       -> TURSO_AUTH_TOKEN
#   4. bun run db:deploy                      (push migrations to Turso,
#      DATABASE_URL/TURSO_AUTH_TOKEN pointed at Turso in your shell or .env;
#      later releases migrate automatically via the Blueprint pre-deploy cmd)
#   5. bun run db:seed                        (same env override, seeds profile)
# On Render set DATABASE_URL + TURSO_AUTH_TOKEN (+ vars below): give
# NEXT_PUBLIC_SITE_URL / BETTER_AUTH_URL = https://<your-domain> for canonical,
# OG, sitemap URLs and Better Auth callbacks. BETTER_AUTH_SECRET can be left to
# the Blueprint's generateValue.
# ---------------------------------------------------------------------------
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Discord bot (send-only notifications)
# The bot no longer accepts slash commands. It only SENDS messages: every
# contact-form submission is mirrored to the owner's DMs (and optionally a
# private log channel) via the Discord REST API.
#   Bot -> Token -> Copy                       = DISCORD_BOT_TOKEN
#   Your user ID (Developer Mode -> Copy ID)   = DISCORD_OWNER_USER_ID
#   Optional log channel mirror                = DISCORD_LOG_CHANNEL_ID
# All three are optional: the site builds and runs without them and simply
# skips DM delivery.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_OWNER_USER_ID=
DISCORD_LOG_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Admin auth (Better Auth, email + password at /login -> /admin dashboard)
# BETTER_AUTH_SECRET: required, min 32 chars (`openssl rand -base64 32`).
# ADMIN_EMAIL / ADMIN_PASSWORD are used ONLY by `bun run db:seed` to create
# the first admin account; remove them from .env after the first seed if you
# like. The dashboard itself is never linked from public pages.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
