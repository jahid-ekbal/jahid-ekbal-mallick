// This is your Prisma schema file,
// learn more about the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
    // Target runtime environment. Default: nodejs
    // runtime  = "nodejs"
}

datasource db {
    provider = "sqlite"
}

model Profile {
    id          String   @id @default("main")
    name        String
    headline    String
    tagline     String
    bio         String
    location    String
    email       String
    avatarUrl   String?
    resumeUrl   String?
    socials     String   @default("{}")
    skills      String   @default("[]")
    experiences String   @default("[]")
    education   String   @default("[]")
    updatedAt   DateTime @updatedAt
}

model Project {
    id          String   @id @default(cuid())
    slug        String   @unique
    title       String
    summary     String
    description String
    coverImage  String?
    techStack   String   @default("[]")
    category    String   @default("General")
    repoUrl     String?
    liveUrl     String?
    featured      Boolean   @default(false)
    published     Boolean   @default(true)
    sortOrder     Int       @default(0)
    repoUpdatedAt DateTime?
    createdAt     DateTime  @default(now())
    updatedAt   DateTime @updatedAt

    @@index([published, sortOrder])
}

model Post {
    id          String    @id @default(cuid())
    seq         Int       @unique
    slug        String    @unique
    title       String
    excerpt     String
    content     String
    coverImage  String?
    tags        String    @default("[]")
    readingTime Int       @default(1)
    status      String    @default("DRAFT")
    source      String    @default("DISCORD")
    publishedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([status, publishedAt])
}

model Message {
    id        String   @id @default(cuid())
    name      String
    email     String
    subject   String
    body      String
    delivered Boolean  @default(false)
    read      Boolean  @default(false)
    createdAt DateTime @default(now())

    @@index([createdAt])
}
